# Copy this file to backend/.env for local development (never commit real secrets).
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MFA_SECRET=replace-with-a-different-long-random-secret
ADMIN_EMAIL=your-login-email@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Portfolio Security <security@your-verified-domain.com>
